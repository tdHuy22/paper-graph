.DS_Store
__pycache__/
.venv/
.tmp/
# chữ toàn văn của bài báo: tạo lại bằng bench/prepare.py, không đưa vào git
*.blocks.json
# PDF của bài người dùng dựng sơ đồ (papers/<tên>/): không đưa vào git
*.pdf
# bản lưu trước khi dựng lại (check --base)
*.graph.old.json
# ảnh cắt từ bài bằng `paper_graph figure`: tạo lại được, và là nội dung của bài
*.figures/
# trang xuất từ sơ đồ (nhúng ảnh, chữ của bài): tạo lại bằng `view`, `quiz`
papers/**/*.html
